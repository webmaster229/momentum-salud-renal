{
  "name": "momentum-salud-renal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "css": "tailwindcss -i ./styles/tailwind.css -o ./app/globals.css --minify",
    "css:watch": "tailwindcss -i ./styles/tailwind.css -o ./app/globals.css --watch",
    "predev": "npm run css || echo css-omitido",
    "dev": "next dev",
    "prebuild": "npm run css || echo css-omitido",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "motion": "^14.8.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
