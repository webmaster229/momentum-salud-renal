/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# material original de diseño (ya copiado y optimizado en public/images)
/PAGINA MOMENTUM SALUD RENAL 2026/
# diseño en Illustrator (87 MB, casi el límite de GitHub)
/pagina-momentum.ai
# originales de Sobre MoMentum (la versión usada está en public/images/sobre)
/BARRA.png
/PORTADA.png
# copia del favicon original (la versión usada es app/icon.png)
/favicon.png
# originales de las fuentes (las que usa la página están en public/fonts)
/tipografia-titulos.otf
/texto-tipografia.otf

# configuración local de Claude Code (rutas de esta máquina)
/.claude/
